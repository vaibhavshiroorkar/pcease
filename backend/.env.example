# PCease Backend v3.0 - Environment Configuration

# Supabase (Get from: https://supabase.com/dashboard → Settings → API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# JWT Secret (generate a strong random string)
# python -c "import secrets; print(secrets.token_hex(32))"
# REQUIRED in production: the app refuses to start with DEBUG=false unless this
# is changed from the default below.
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Set DEBUG=false in production (enables the SECRET_KEY safety check)
DEBUG=true

# Google Gemini AI (Get from: https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Agent (optional — Gemini already supported; Claude optional)
ANTHROPIC_API_KEY=
LLM_PROVIDER=claude
